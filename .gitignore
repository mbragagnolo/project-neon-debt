# Godot 4 editor/import cache — regenerated by `godot --import`, never committed.
game/.godot/
game/android/

# Exported builds
game/build/
game/export_presets.cfg
*.translation

# GUT scratch
game/.gut_editor_config.json
game/.gut_editor_shortcuts.cfg

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Python tool caches
__pycache__/

# Third-party reference screenshots (docs/art/refs/README.md stays tracked; the images do not)
docs/art/refs/*
!docs/art/refs/README.md

# Diffusion candidates and intermediates for the art pass (tools/art/gen_still.py)
game/tools/art/work/

# The autoplayer's per-run logs (megabytes per seed); the report, rows and heat beside them are kept
runs/*/logs/
runs/work/

# game-feel (kiln): the harness samples and scratch
feel/work/
feel/runs/*/samples*.jsonl
